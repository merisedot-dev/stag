<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 0.96.3 -->
<interface>
  <!-- interface-name entity.ui -->
  <requires lib="gtk" version="4.0"/>
  <template class="StagEntityEditor" parent="GtkBox">
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkStackSwitcher">
        <property name="halign">center</property>
        <property name="name">stack</property>
      </object>
    </child>
    <child>
      <object class="GtkStack" id="ent_stack">
        <property name="transition-type">crossfade</property>
        <property name="vexpand">True</property>
        <child>
          <object class="GtkStackPage">
            <property name="child">
              <object class="GtkScrolledWindow"/>
            </property>
            <property name="name">fields</property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
